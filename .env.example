# API Key de Google Gemini para generación de estrategias, hitos y reportes PAEC con IA
GEMINI_API_KEY=

# Base de Datos en la Nube Supabase (PostgreSQL Cloud Gratuito)
# Obtén estas credenciales en https://supabase.com > Project Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica-supabase

# Puerto del servidor local (opcional)
PORT=3000
